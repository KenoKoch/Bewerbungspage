@implements IDisposable
@inject PresenceTracker Presence
@inject ActivityFeed Feed
@inject MetricsBuffer Metrics
@inject TimeProvider Time

<div class="ap">
    <section class="card ap__presence">
        <div class="ap__orb" aria-hidden="true">
            <span class="ap__ring"></span>
            <span class="ap__ring ap__ring--2"></span>
            <span class="ap__ring ap__ring--3"></span>
            <span class="ap__orb-core"><Icon Name="users" Size="28" /></span>
        </div>
        <div class="ap__count" aria-live="polite">
            <span class="ap__count-value" @key="Presence.OnlineCount">@(_interactive ? Fmt.Number(Presence.OnlineCount) : "–")</span>
            <span class="ap__count-label">@(Presence.OnlineCount == 1 ? "Besucher ist" : "Besucher sind") gerade online</span>
            <span class="ap__count-sub">Spitze heute: @(_interactive ? Fmt.Number(Presence.PeakToday) : "–") · Sie eingeschlossen</span>
        </div>

        <div class="ap__react">
            <p class="ap__react-title">Schicken Sie allen Besuchern ein Emoji</p>
            <div class="ap__react-buttons">
                @foreach (var emoji in ActivityFeed.AllowedReactions)
                {
                    var current = emoji;
                    <button type="button" class="ap__emoji" disabled="@(!_interactive || _cooldown)" @onclick="() => React(current)" aria-label="@($"{current} an alle senden")">@current</button>
                }
            </div>
            <p class="ap__react-hint">
                @if (_reactionInfo is not null)
                {
                    <span>@_reactionInfo</span>
                }
                else
                {
                    <span>Das Emoji fliegt bei allen geöffneten Seiten aus dem Live-Zähler oben rechts.</span>
                }
            </p>
        </div>
    </section>

    <section class="card ap__feed" aria-labelledby="ap-feed-title">
        <header class="ap__feed-head">
            <h3 id="ap-feed-title">Aktivität in Echtzeit</h3>
            <span class="badge badge--live"><span class="dot"></span>live</span>
        </header>

        @{
            var items = Feed.Items.Take(10).ToArray();
            var now = Time.GetUtcNow();
        }
        @if (items.Length == 0)
        {
            <div class="ap__empty">
                <Icon Name="activity" Size="22" />
                <p>Noch keine Aktivität seit dem letzten Neustart. Starten Sie die SPS-Simulation, schreiben Sie ins Gästebuch oder senden Sie ein Emoji – alle Besucher sehen es sofort.</p>
            </div>
        }
        else
        {
            <ul class="ap__list" aria-live="polite">
                @foreach (var item in items)
                {
                    <li @key="item.Id" class="ap__item ap__item--@item.Kind.ToString().ToLowerInvariant()">
                        <span class="ap__item-icon">
                            @if (item.Emoji is not null)
                            {
                                <span aria-hidden="true">@item.Emoji</span>
                            }
                            else
                            {
                                <Icon Name="@item.Icon" Size="15" />
                            }
                        </span>
                        <span class="ap__item-text">@item.Text</span>
                        <time class="ap__item-time" datetime="@item.At.ToString("O")">@Fmt.Relative(item.At, now)</time>
                    </li>
                }
            </ul>
        }

        <footer class="ap__how">
            <Icon Name="info" Size="15" />
            <span>Ein <code>CircuitHandler</code> zählt die Verbindungen, Module melden Ereignisse per <code>IEventBus</code>, und jede Komponente rendert über ihren eigenen SignalR-Circuit neu.</span>
        </footer>
    </section>
</div>

@code {
    private bool _interactive;
    private bool _cooldown;
    private bool _disposed;
    private string? _reactionInfo;
    private Timer? _clock;

    protected override void OnInitialized()
    {
        _interactive = RendererInfo.IsInteractive;
        if (!_interactive)
        {
            return;
        }

        Presence.Changed += OnChanged;
        Feed.Added += OnActivity;

        // Relative Zeitangaben ("vor 12 s") regelmäßig auffrischen.
        _clock = new Timer(_ => OnChanged(), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task React(string emoji)
    {
        if (_cooldown)
        {
            return;
        }

        if (Feed.TryReact(emoji))
        {
            Metrics.Increment(MetricNames.Reaction);
            _reactionInfo = $"{emoji} wurde an {Fmt.Number(Presence.OnlineCount)} {(Presence.OnlineCount == 1 ? "Verbindung" : "Verbindungen")} gepusht.";
        }
        else
        {
            _reactionInfo = "Gerade fliegen sehr viele Emojis – bitte einen Moment warten.";
        }

        _cooldown = true;
        StateHasChanged();
        await Task.Delay(2000);
        _cooldown = false;
    }

    private void OnActivity(ActivityItem item) => OnChanged();

    private void OnChanged()
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        _disposed = true;
        _clock?.Dispose();
        Presence.Changed -= OnChanged;
        Feed.Added -= OnActivity;
    }
}
