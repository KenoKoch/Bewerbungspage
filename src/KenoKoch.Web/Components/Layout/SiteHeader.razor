@using KenoKoch.Modules.Analytics.Components

<header class="site-header" data-site-header>
    <div class="container site-header__inner">
        <a href="/" class="brand" aria-label="Keno Koch – zur Startseite">
            <span class="brand__mark" aria-hidden="true">KK</span>
            <span class="brand__text">
                <span class="brand__name">Keno Koch</span>
                <span class="brand__role">Software Engineer · .NET</span>
            </span>
        </a>

        <nav id="site-nav" class="site-nav" aria-label="Hauptnavigation">
            <a href="/#ueber-mich" data-spy="ueber-mich">Über mich</a>
            <a href="/#werdegang" data-spy="werdegang">Werdegang</a>
            <a href="/#skills" data-spy="skills">Skills</a>
            <NavLink href="/demos" ActiveClass="is-active">Live-Demos</NavLink>
            <NavLink href="/architektur" ActiveClass="is-active">Architektur</NavLink>
            <a href="/#kontakt" class="site-nav__cta" data-spy="kontakt">Kontakt</a>
        </nav>

        <div class="site-header__actions">
            <LiveBadge @rendermode="InteractiveServer" />
            <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Zwischen hellem und dunklem Design wechseln" title="Design wechseln">
                <Icon Name="sun" Size="18" Class="theme-toggle__sun" />
                <Icon Name="moon" Size="18" Class="theme-toggle__moon" />
            </button>
            <button type="button" class="icon-btn site-header__menu" data-nav-toggle aria-controls="site-nav" aria-expanded="false" aria-label="Menü öffnen">
                <Icon Name="menu" Size="20" Class="site-header__menu-open" />
                <Icon Name="x" Size="20" Class="site-header__menu-close" />
            </button>
        </div>
    </div>
</header>
